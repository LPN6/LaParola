<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical" >

	<LinearLayout
	    android:layout_width="match_parent"
	    android:layout_height="wrap_content"
	    android:orientation="horizontal" 
	    android:id="@+id/buttons">

		<Button
			android:id="@+id/button_bible"
			style="@style/Widget.TabPageIndicatorLight"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:paddingLeft="12dip"
			android:paddingRight="12dip"
			android:text="@string/type_bible" />

		<Button
			android:id="@+id/button_commentario"
			style="@style/Widget.TabPageIndicatorLight"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:paddingLeft="6dip"
			android:paddingRight="6dip"
			android:text="@string/type_commentario" />

		<!--
		//rmw1024
		<Button
			android:id="@+id/button_dizionario"
			style="@style/Widget.TabPageIndicatorLight"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:paddingLeft="12dip"
			android:paddingRight="12dip"
			android:text="@string/type_dictionary" />
			-->

	</LinearLayout>

    <ListView
        android:id="@+id/list_view"
        android:layout_width="match_parent"
        android:layout_height="0dp" 
        android:layout_weight="1" 
        />

    <View
        android:id="@+id/separator"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@drawable/list_divider_holo_light" />
    
    <Button 
        android:id="@+id/library_button"
        android:text="@string/version_management"
        android:layout_width="match_parent"
        android:layout_gravity="start"
        android:maxLines="2"
        style="@style/ButtonHoloLight.Borderless.Small"
        android:textSize="14sp"
        android:minHeight="@dimen/alert_dialog_button_bar_height"
        android:layout_height="wrap_content" />
</LinearLayout>