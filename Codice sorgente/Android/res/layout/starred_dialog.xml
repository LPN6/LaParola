<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp"
    android:background="?attr/colorSurface"
    >

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/description_layout"
        style="@style/Widget.Material3.TextInputLayout.FilledBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/description"
        app:boxBackgroundMode="filled"
        app:boxBackgroundColor="?attr/colorSurfaceContainerHighest"
        app:hintTextColor="?attr/colorOnSurfaceVariant"
        app:startIconTint="?attr/colorOnSurfaceVariant"
        app:endIconTint="?attr/colorOnSurfaceVariant"
        app:hintEnabled="true"
        app:boxStrokeColor="?attr/colorOutlineVariant">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences|textMultiLine"
            android:autofillHints="description"
            android:gravity="top|start"
            android:minLines="2"
            android:maxLines="8"
            android:scrollbars="vertical"
            android:overScrollMode="ifContentScrolls"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant"
            android:imeOptions="actionDone">
            <requestFocus />
        </com.google.android.material.textfield.TextInputEditText>
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>