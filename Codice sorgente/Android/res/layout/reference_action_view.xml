<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/reference_action_view"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:baselineAligned="false">

    <LinearLayout
        android:id="@+id/bcv_linear_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:visibility="visible">

		<net.laparola.ui.android.ignspinner.ListSpinner
			android:id="@+id/book_spinner"
			style="@style/Widget.AppCompat.Spinner.DropDown"
			android:layout_width="0dp"
			android:layout_weight="1"
			android:layout_height="?attr/dropdownListPreferredItemHeight"
			android:layout_gravity="center"
			/> <!-- min width: 90dp -->

		<net.laparola.ui.android.ignspinner.GridSpinner
			android:id="@+id/chapter_spinner"
			style="@style/Widget.AppCompat.Spinner.DropDown"
            android:layout_width="wrap_content"
			android:layout_height="?attr/dropdownListPreferredItemHeight"
            android:minWidth="64dp"
			android:layout_gravity="center"
			android:dropDownWidth="264dp"
			/>

		<net.laparola.ui.android.ignspinner.GridSpinner
			android:id="@+id/verse_spinner"
			style="@style/Widget.AppCompat.Spinner.DropDown"
            android:layout_width="wrap_content"
			android:layout_height="?attr/dropdownListPreferredItemHeight"
            android:minWidth="64dp"
			android:layout_gravity="center"
			android:dropDownWidth="264dp"
			/>

        <ImageButton
            android:id="@+id/reference_edit_btn"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:scaleType="centerInside"
            android:src="@drawable/ic_action_edit"
            android:focusable="true"
            android:contentDescription="@string/modifica"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="?attr/colorOnPrimary"
			android:padding="8dp" />
    </LinearLayout>
        
    <LinearLayout 
        android:id="@+id/fullref_linear_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:visibility="gone"
        >
        
	    <EditText android:id="@+id/reference_edittext"
	        android:layout_width="0dp"
	        android:layout_height="wrap_content"
	        android:layout_weight="1"
            android:autofillHints=""
            android:hint="@string/reference_hint"
	        android:saveEnabled="true"
	        android:scrollHorizontally="true"
	        android:selectAllOnFocus="true"
	        android:singleLine="true"
	        android:imeOptions="actionGo"
            android:inputType="textNoSuggestions"
	        />
    
	    <ImageButton android:id="@+id/reference_go_btn"
	        android:layout_width="wrap_content"
	        android:layout_height="match_parent"
			android:scaleType="centerInside"
	        android:src="@drawable/ic_action_send"
	        android:focusable="true"
	        android:contentDescription="@string/search"
	        android:visibility="gone"
	        />    
    </LinearLayout>

</LinearLayout>
