<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:installLocation="auto"
    android:versionCode="100"
    android:versionName="2.0.0">

    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Some Chromebooks don't support touch. Although not essential,
 it's a good idea to explicitly include this declaration.   -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".ui.android.LaParolaApplication"
        android:backupAgent=".ui.android.LaParolaBackupAgent"
        android:fullBackupOnly="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:restoreAnyVersion="true"
        android:usesCleartextTraffic="true"
        android:fullBackupContent="true"
        android:allowBackup="true">

        <meta-data
            android:name="android.max_aspect"
            android:value="2.1" />

        <meta-data
            android:name="com.google.android.backup.api_key"
            android:value="AEdPqrEAAAAI-vfNFipbQ83T0MY8LBKsJkWKDYFEhsynV6NREw" />

        <activity
            android:name=".ui.android.LaParolaActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="true"
            android:label="@string/app_name"
            android:uiOptions="splitActionBarWhenNarrow">
            <!--android:theme="@style/Theme.IgnazioHolo"-->
            <!--android:uiOptions="splitActionBarWhenNarrow"-->

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.android.library.LibraryActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:label="@string/version_management"
             />
        <!--android:theme="@style/Theme.IgnazioHolo"-->

        <activity
            android:name=".ui.android.library.downloadmanager.CancelDownloadActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:label="@string/download_cancel"
             />
        <!--android:theme="@style/Theme.IgnazioHolo.Dialog"-->

        <activity
            android:name=".ui.android.LaParolaPreferencesActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:label="@string/preferences"
             />
        <!--android:theme="@style/Theme.IgnazioHolo.Preferences"-->

        <service
            android:name=".ui.android.library.downloadmanager.LibraryDownloaderService"
            android:exported="false" />

    </application>

</manifest>