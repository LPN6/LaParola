<UserControl x:Class="LaParola.ToolViews.AggiungiTesti"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:LaParola"
        xmlns:local="clr-namespace:LaParola.ToolViews"
        mc:Ignorable="d"
        Loaded="Window_Loaded">

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="170" />
        </Grid.ColumnDefinitions>

        <!-- Left Column: Main Data Table & Loading Overlay -->
        <Grid Grid.Column="0" Margin="0,0,15,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Search / Quick Filter -->
            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                <Label Content="{DynamicResource AggiungiTestiFiltro}" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtFiltro" TextChanged="TxtFiltro_TextChanged" 
                         VerticalContentAlignment="Center" Padding="4,2"/>
                <DockPanel.ToolTip>
                    <ToolTip>
                        <TextBlock Text="{DynamicResource AggiungiTestiFiltroAiuto}" TextWrapping="Wrap" MaxWidth="300"/>
                    </ToolTip>
                </DockPanel.ToolTip>
            </DockPanel>

            <!-- Data Table -->
            <DataGrid x:Name="GridTesti" Grid.Row="1" 
                      AutoGenerateColumns="False" 
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      SelectionMode="Single"
                      Background="Transparent"
                      BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      MouseMove="GridTesti_MouseMove">

                <!-- Highlight Rows with Updates -->
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HaAggiornamentoDisponibile}" Value="True">
                                <Setter Property="Background" Value="#0DFF9800"/>
                                <!-- Subtle Orange Tint -->
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <!-- Text Name -->
                    <DataGridTextColumn Header="{DynamicResource AggiungiTestiColonnaNome}" Binding="{Binding Nome}" Width="Auto" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="6,0,6,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Type -->
                    <DataGridTextColumn Header="{DynamicResource AggiungiTestiColonnaTipo}" Binding="{Binding Tipo}" Width="Auto" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="12,0,12,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Status Column (Badges for New vs Update) -->
                    <DataGridTemplateColumn Header="{DynamicResource AggiungiTestiColonnaStato}" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Padding="6,2,6,2" Margin="6,0,6,0" CornerRadius="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#2196F3"/>
                                            <!-- Blue for New -->
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HaAggiornamentoDisponibile}" Value="True">
                                                    <Setter Property="Background" Value="#FF9800"/>
                                                    <!-- Orange for Update -->
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                        <!-- Version Detail (e.g., 1.0 -> 2.0 or 1.5) -->
                                        <TextBlock Text="{Binding DettaglioVersione}" FontSize="10" Foreground="#FFFFFF" VerticalAlignment="Center" Opacity="0.9"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Size -->
                    <DataGridTextColumn Header="{DynamicResource AggiungiTestiColonnaDimensione}" Binding="{Binding Dimensione}" Width="Auto" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Margin" Value="6,0,6,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Download Checkbox -->
                    <DataGridTemplateColumn Header="{DynamicResource AggiungiTestiColonnaScarica}" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding DaScaricare, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                          IsEnabled="{Binding CanBeDownloaded}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Hide Option -->
                    <DataGridTemplateColumn Header="{DynamicResource AggiungiTestiColonnaNascondi}" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding DaNascondere, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>

                <DataGrid.ToolTip>
                    <ToolTip x:Name="DataGridToolTip" Opened="DataGridToolTip_Opened" Closed="DataGridToolTip_Closed">
                        <TextBlock Text="{DynamicResource AggiungiTestiGrigiaAiuto}" TextWrapping="Wrap" MaxWidth="300"/>
                    </ToolTip>
                </DataGrid.ToolTip>
            </DataGrid>

            <!-- Async Loading Overlay -->
            <Border x:Name="OverlayCaricamento" Grid.Row="0" Grid.RowSpan="2" 
                    Background="{DynamicResource ControlBackgroundBrush}" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ProgressBar x:Name="OverlayProgress" IsIndeterminate="True" Width="180" Height="15" Margin="0,0,0,10"/>
                    <TextBlock x:Name="OverlayTesto" Text="{DynamicResource AggiungiTestiPreparazione}" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Right Column: Control Buttons -->
        <StackPanel Grid.Column="1" VerticalAlignment="Top">
            <controls:HelpFlyout x:Name="HelpFlyoutControl" HorizontalAlignment="Right" Margin="0,8,0,0" HelpText="{DynamicResource AggiungiTestiAiuto}" HelpClicked="HelpFlyout_OnHelpClicked"/>

            <Button x:Name="BtnApplica" Content="{DynamicResource AggiungiTestiApplica}" 
                    FontWeight="Bold" Margin="0,10,0,10" 
                    Click="BtnApplica_Click">
                <Button.ToolTip>
                    <ToolTip>
                        <TextBlock Text="{DynamicResource AggiungiTestiApplicaAiuto}" TextWrapping="Wrap" MaxWidth="300"/>
                    </ToolTip>
                </Button.ToolTip>
            </Button>

            <Button x:Name="BtnSelezionaTutti" Content="{DynamicResource AggiungiTestiScaricaTutti}" 
                    Margin="0,0,0,6" Width="Auto"
                    Click="BtnSelezionaTutti_Click">
                <Button.ToolTip>
                    <ToolTip>
                        <TextBlock Text="{DynamicResource AggiungiTestiScaricaTuttiAiuto}" TextWrapping="Wrap" MaxWidth="300"/>
                    </ToolTip>
                </Button.ToolTip>
            </Button>

            <Button x:Name="BtnDeselezionaTutti" Content="{DynamicResource AggiungiTestiDeselezionaTutti}" 
                    Margin="0,0,0,15" 
                    Click="BtnDeselezionaTutti_Click">
                <Button.ToolTip>
                    <ToolTip>
                        <TextBlock Text="{DynamicResource AggiungiTestiDeselezionaTuttiAiuto}" TextWrapping="Wrap" MaxWidth="300"/>
                    </ToolTip>
                </Button.ToolTip>
            </Button>

            <Button x:Name="BtnMostraNascosti" Content="{DynamicResource AggiungiTestiMostraNascosti}" 
                    Margin="0,0,0,15" 
                    Click="BtnMostraNascosti_Click">
                <Button.ToolTip>
                    <ToolTip>
                        <TextBlock Text="{DynamicResource AggiungiTestiMostraNascostiAiuto}" TextWrapping="Wrap" MaxWidth="300"/>
                    </ToolTip>
                </Button.ToolTip>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>