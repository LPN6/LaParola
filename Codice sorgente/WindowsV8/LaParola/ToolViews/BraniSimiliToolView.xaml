<UserControl x:Class="LaParola.ToolViews.BraniSimiliToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LaParola.ToolViews"
             xmlns:controls="clr-namespace:LaParola"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Margin="0,8,0,0" Text="{DynamicResource BraniSimiliBrano}" />

            <controls:HelpFlyout
                x:Name="HelpFlyoutControl"
        Grid.Column="1"
        Margin="0,8,0,0"
        HelpText="{DynamicResource BraniSimiliAiuto}"
        HelpClicked="HelpFlyout_OnHelpClicked"/>
        </Grid>

        <TextBox x:Name="tbBrano" Grid.Row="1" Margin="0,12,0,0" KeyUp="Brano_KeyUp" ToolTipService.ShowDuration="10000">
            <TextBox.ToolTip>
                <ToolTip>
                    <TextBlock Text="{DynamicResource BraniSimiliBranoAiuto}"
                       TextWrapping="Wrap"
                       MaxWidth="300"/>
                </ToolTip>
            </TextBox.ToolTip>
        </TextBox>

        <TextBlock Grid.Row="2" Margin="0,8,0,0" Text="{DynamicResource BraniSimiliVersione}" />

        <ComboBox x:Name="cbVersione" Grid.Row="3" Margin="0,8,0,0" ToolTipService.ShowDuration="10000" Background="{DynamicResource ControlBackgroundBrush}" ItemsSource="{Binding VersioneItems}" SelectedItem="{Binding SelectedVersione, Mode=TwoWay}">
            <ComboBox.ToolTip>
                <ToolTip>
                    <TextBlock Text="{DynamicResource BraniSimiliVersioneAiuto}"
                       TextWrapping="Wrap"
                       MaxWidth="300"/>
                </ToolTip>
            </ComboBox.ToolTip>
        </ComboBox>

        <GroupBox x:Name="GbTipo" Grid.Row="4" Header="{DynamicResource BraniSimiliNumero}" Margin="0,12,0,0" Padding="12">
            <GroupBox.ToolTip>
                <ToolTip>
                    <TextBlock Text="{DynamicResource BraniSimiliNumeroAiuto}" TextWrapping="Wrap" MaxWidth="300"/>
                </ToolTip>
            </GroupBox.ToolTip>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Slider x:Name="SliderNumero" Grid.Row="0" Grid.Column="0" 
            Minimum="1" Maximum="100" 
            Value="{Binding Numero, Mode=TwoWay}" 
            TickFrequency="1" 
            IsSnapToTickEnabled="True" 
            VerticalAlignment="Center" />

                <TextBox Grid.Row="0" Grid.Column="1" Width="50"
             Margin="8,0,0,0" TextAlignment="Center" VerticalAlignment="Center"
             Text="{Binding ElementName=SliderNumero, Path=Value, UpdateSourceTrigger=PropertyChanged}" />

                <RadioButton x:Name="rbVersetti" Grid.Row="2"
                         Content="{DynamicResource BraniSimiliVersetti}"
                         GroupName="Tipo"
                         IsChecked="{Binding IsVersetti, Mode=TwoWay}"
                         VerticalAlignment="Center"/>
                <RadioButton x:Name="rbCapitoli" Grid.Row="2"
                         Content="{DynamicResource BraniSimiliCapitoli}"
                         GroupName="Tipo"
                         IsChecked="{Binding IsCapitoli, Mode=TwoWay}"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"/>

            </Grid>
        </GroupBox>

        <Button x:Name="PulAvvia" Grid.Row="5" Margin="0,14,0,0" IsDefault="True" Padding="10,8" Content="{DynamicResource BraniSimiliAvvia}" Click="BraniSimili_Click" HorizontalAlignment="Right" />

    </Grid>
</UserControl>
