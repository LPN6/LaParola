<UserControl x:Class="LaParola.ToolViews.TextGeneratorToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LaParola"
             
             Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource AppForegroundBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Margin="0,8,0,0" Text="{DynamicResource MostraRiferimento}" />

            <controls:HelpFlyout
                x:Name="HelpFlyoutControl"
        Grid.Column="1"
        Margin="0,8,0,0"
        HelpText="{DynamicResource MostraAiuto}"
        HelpClicked="HelpFlyout_OnHelpClicked"/>
        </Grid>

        <TextBox x:Name="tbBrano" Grid.Row="1" Margin="0,12,0,0" KeyUp="Brano_KeyUp" ToolTipService.ShowDuration="10000">
            <TextBox.ToolTip>
                <ToolTip>
                    <TextBlock Text="{DynamicResource MostraRiferimentoAiuto}"
                       TextWrapping="Wrap"
                       MaxWidth="300"/>
                </ToolTip>
            </TextBox.ToolTip>

        </TextBox>
        <TextBlock Grid.Row="2" Margin="0,8,0,0" TextWrapping="Wrap" Opacity="0.85" Text="{DynamicResource MostraTesti}" />

        <ListBox Grid.Row="3"
         ItemsSource="{Binding VersioneItems}"
         ToolTipService.ShowDuration="10000"
         AllowDrop="True"
         PreviewMouseLeftButtonDown="ListBox_PreviewMouseLeftButtonDown"
         PreviewMouseMove="ListBox_PreviewMouseMove"
         PreviewMouseLeftButtonUp="ListBox_PreviewMouseLeftButtonUp"
         DragOver="ListBox_DragOver"
         Drop="ListBox_Drop"
         Background="{DynamicResource ControlBackgroundBrush}"
         BorderThickness="0"
         >

            <ListBox.ToolTip>
                <ToolTip>
                    <TextBlock Text="{DynamicResource MostraTestiAiuto}"
                       TextWrapping="Wrap"
                       MaxWidth="300"/>
                </ToolTip>
            </ListBox.ToolTip>
            
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding Name}"
                      IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      Foreground="{DynamicResource AppForegroundBrush}"
                      Background="Transparent"/>
                </DataTemplate>
            </ListBox.ItemTemplate>

            <!-- FULLY CONTROL HOVER -->
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">

                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Padding" Value="2"/>

                    <Style.Triggers>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#FF3A3A3A"/>
                        </Trigger>

                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#FF404040"/>
                        </Trigger>

                    </Style.Triggers>

                </Style>
            </ListBox.ItemContainerStyle>

        </ListBox>

        <Grid Grid.Row="4" Margin="0,10,0,0"
      HorizontalAlignment="Center">

            <Grid Grid.IsSharedSizeScope="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="btns"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="btns"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnSeleziona"
                Content="{DynamicResource MostraSeleziona}"
                Click="Seleziona_Click"
                MinWidth="100"
                Margin="0,0,10,0"/>

                <Button x:Name="btnDeseleziona"
                Content="{DynamicResource MostraDeseleziona}"
                Click="Deseleziona_Click"
                Grid.Column="1"
                MinWidth="100"
                Margin="10,0,0,0"/>
            </Grid>
        </Grid>
        <CheckBox x:Name="cbAlternare" Grid.Row="5" Margin="0,14,0,0" IsChecked="False"
                  Content="{DynamicResource MostraAlterna}" Click="Alternare_Click"
                  ToolTipService.ShowDuration="10000"
                  >
            <CheckBox.ToolTip>
                <ToolTip>
                    <TextBlock Text="{DynamicResource MostraAlternaAiuto}"
                       TextWrapping="Wrap"
                       MaxWidth="300"/>
                </ToolTip>
            </CheckBox.ToolTip>

        </CheckBox>
        <Button x:Name="btnMostra" Grid.Row="6" Margin="0,14,0,0" IsDefault="True" Padding="10,8" Content="{DynamicResource MostraMostra}" Click="Generate_Click" HorizontalAlignment="Right" />
    </Grid>
</UserControl>
