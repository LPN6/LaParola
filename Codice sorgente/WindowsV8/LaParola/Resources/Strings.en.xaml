    <sys:String x:Key="EditorTitle">Document</sys:String>
    <sys:String x:Key="EditorAiuto">In this window you can load text from a file or generate text it from some of the Tools windows. There are some commands to format the text in the window toolbar, and others in the main menu.</sys:String>
