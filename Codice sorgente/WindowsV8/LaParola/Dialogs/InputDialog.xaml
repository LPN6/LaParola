<Window x:Class="LaParola.Dialogs.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="360" Height="160" 
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False" WindowStyle="ToolWindow"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptTextBlock" FontWeight="Medium" Margin="0,0,0,8" TextWrapping="Wrap"
                   Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />

        <TextBox x:Name="InputTextBox" Grid.Row="1" Height="26" VerticalAlignment="Top" Padding="3,1"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
            <Button Content="OK" Width="75" IsDefault="True" Click="OkButton_Click" Margin="0,0,10,0" Height="26"/>
            <Button Content="Cancel" Width="75" IsCancel="True" Height="26"/>
        </StackPanel>
    </Grid>
</Window>