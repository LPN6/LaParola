<Window x:Class="LaParola.Dialogs.ImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LaParola.Dialogs" xmlns:controls="clr-namespace:LaParola"
        mc:Ignorable="d"
        Title="{DynamicResource ImportaDialogoTitolo}"
        Height="650" Width="480"
        MinHeight="550" MinWidth="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:HelpFlyout
                x:Name="HelpFlyoutControl"
            HorizontalAlignment="Right"
                Grid.Row="0"
                Margin="0,0,0,0"
                HelpText="{DynamicResource ImportaDialogoAiuto}"
                HelpClicked="HelpFlyout_OnHelpClicked"/>

        <!-- Scrollable Form Area -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto" 
                      Padding="0,0,10,0">
            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row Style Helper -->
                <Grid.Resources>
                    <Style TargetType="Label">
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Margin" Value="0,5,10,5"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Style>
                    <Style TargetType="TextBox">
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Margin" Value="0,5,0,5"/>
                        <Setter Property="Padding" Value="5"/>
                    </Style>
                </Grid.Resources>

                <!-- File/Directory -->
                <Label Grid.Row="0" Grid.Column="0" x:Name="LabelFile" Content="{DynamicResource ImportaDialogoFile}" />
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtFile" IsReadOnly="True" HorizontalScrollBarVisibility="Auto">
                    <TextBox.ToolTip>
                        <ToolTip>
                            <TextBlock x:Name="TooltipFile" Text="{DynamicResource ImportaDialogoFileAiuto}" TextWrapping="Wrap" MaxWidth="300"/>
                        </ToolTip>
                    </TextBox.ToolTip>
                </TextBox>

                <!-- Import Type Selection -->
                <Label Grid.Row="1" Grid.Column="0" x:Name="LabelCome" Content="{DynamicResource ImportaDialogoCome}" VerticalAlignment="Center" />
                <StackPanel Grid.Row="1" Grid.Column="1" x:Name="StackCome" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel.ToolTip>
                        <ToolTip>
                            <TextBlock Text="{DynamicResource ImportaDialogoComeAiuto}" TextWrapping="Wrap" MaxWidth="300"/>
                        </ToolTip>
                    </StackPanel.ToolTip>
                    <RadioButton x:Name="ComeCommentario" 
                                 Content="{DynamicResource ImportaDialogoComeCommentario}" 
                                 GroupName="ImportType" 
                                 Margin="0,0,20,0" 
                                 VerticalContentAlignment="Center" />

                    <RadioButton x:Name="ComeLibro" 
                                 Content="{DynamicResource ImportaDialogoComeLibro}" 
                                 GroupName="ImportType" 
                                 IsChecked="True" 
                                 VerticalContentAlignment="Center" />
                </StackPanel>

                <!-- Title -->
                <Label Grid.Row="2" Grid.Column="0" Content="{DynamicResource ImportaDialogoTitoloTesto}" />
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtTitle" >
                    <TextBox.ToolTip>
                        <ToolTip>
                            <TextBlock Text="{DynamicResource ImportaDialogoTitoloTestoAiuto}" TextWrapping="Wrap" MaxWidth="300"/>
                        </ToolTip>
                    </TextBox.ToolTip>
                </TextBox>

                <!-- Abbreviation -->
                <Label Grid.Row="3" Grid.Column="0" Content="{DynamicResource ImportaDialogoAbbreviazione}" />
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtAbbreviation" >
                    <TextBox.ToolTip>
                        <ToolTip>
                            <TextBlock Text="{DynamicResource ImportaDialogoAbbreviazioneAiuto}" TextWrapping="Wrap" MaxWidth="300"/>
                        </ToolTip>
                    </TextBox.ToolTip>
                </TextBox>

                <!-- Author -->
                <Label Grid.Row="4" Grid.Column="0" Content="{DynamicResource ImportaDialogoAutore}" />
                <TextBox Grid.Row="4" Grid.Column="1" x:Name="TxtAuthor" >
                    <TextBox.ToolTip>
                        <ToolTip>
                            <TextBlock Text="{DynamicResource ImportaDialogoAutoreAiuto}" TextWrapping="Wrap" MaxWidth="300"/>
                        </ToolTip>
                    </TextBox.ToolTip>
                </TextBox>

                <!-- Language -->
                <Label Grid.Row="5" Grid.Column="0" Content="{DynamicResource ImportaDialogoLingua}" />
                <TextBox Grid.Row="5" Grid.Column="1" x:Name="TxtLanguage" >
                    <TextBox.ToolTip>
                        <ToolTip>
                            <TextBlock Text="{DynamicResource ImportaDialogoLinguaAiuto}" TextWrapping="Wrap" MaxWidth="300"/>
                        </ToolTip>
                    </TextBox.ToolTip>
                </TextBox>

                <!-- Date -->
                <Label Grid.Row="6" Grid.Column="0" Content="{DynamicResource ImportaDialogoData}" />
                <TextBox Grid.Row="6" Grid.Column="1" x:Name="TxtDate" >
                    <TextBox.ToolTip>
                        <ToolTip>
                            <TextBlock Text="{DynamicResource ImportaDialogoDataAiuto}" TextWrapping="Wrap" MaxWidth="300"/>
                        </ToolTip>
                    </TextBox.ToolTip>
                </TextBox>

                <!-- Publisher -->
                <Label Grid.Row="7" Grid.Column="0" Content="{DynamicResource ImportaDialogoCasaEditrice}" />
                <TextBox Grid.Row="7" Grid.Column="1" x:Name="TxtPublisher" >
                    <TextBox.ToolTip>
                        <ToolTip>
                            <TextBlock Text="{DynamicResource ImportaDialogoPublisherAiuto}" TextWrapping="Wrap" MaxWidth="300"/>
                        </ToolTip>
                    </TextBox.ToolTip>
                </TextBox>

                <!-- Copyright -->
                <Label Grid.Row="8" Grid.Column="0" Content="{DynamicResource ImportaDialogoCopyright}" />
                <TextBox Grid.Row="8" Grid.Column="1" x:Name="TxtCopyright" >
                    <TextBox.ToolTip>
                        <ToolTip>
                            <TextBlock Text="{DynamicResource ImportaDialogoCopyrightAiuto}" TextWrapping="Wrap" MaxWidth="300"/>
                        </ToolTip>
                    </TextBox.ToolTip>
                </TextBox>

                <!-- ISBN -->
                <Label Grid.Row="9" Grid.Column="0" Content="{DynamicResource ImportaDialogoIsbn}" />
                <TextBox Grid.Row="9" Grid.Column="1" x:Name="TxtIsbn" >
                    <TextBox.ToolTip>
                        <ToolTip>
                            <TextBlock Text="{DynamicResource ImportaDialogoIsbnAiuto}" TextWrapping="Wrap" MaxWidth="300"/>
                        </ToolTip>
                    </TextBox.ToolTip>
                </TextBox>

                <!-- Bible of Notes -->
                <Label Grid.Row="10" Grid.Column="0" Content="{DynamicResource ImportaDialogoBibbiaDiNote}" />
                <TextBox Grid.Row="10" Grid.Column="1" x:Name="TxtBibleOfNotes" >
                    <TextBox.ToolTip>
                        <ToolTip>
                            <TextBlock Text="{DynamicResource ImportaDialogoBibbiaDiNoteAiuto}" TextWrapping="Wrap" MaxWidth="300"/>
                        </ToolTip>
                    </TextBox.ToolTip>
                </TextBox>

                <!-- Description (Multiline) -->
                <Label Grid.Row="11" Grid.Column="0" Content="{DynamicResource ImportaDialogoDescrizione}" VerticalAlignment="Top" Margin="0,8,10,5" />
                <TextBox Grid.Row="11" Grid.Column="1" x:Name="TxtDescription" 
                         AcceptsReturn="True" 
                         TextWrapping="Wrap" 
                         VerticalScrollBarVisibility="Auto" 
                         MinHeight="100" 
                         MaxHeight="200" 
                         VerticalAlignment="Top" >
                    <TextBox.ToolTip>
                        <ToolTip>
                            <TextBlock Text="{DynamicResource ImportaDialogoDescrizioneAiuto}" TextWrapping="Wrap" MaxWidth="300"/>
                        </ToolTip>
                    </TextBox.ToolTip>
                </TextBox>
            </Grid>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="0,15,0,0">
            <Button Content="{DynamicResource PulsanteOK}" 
                    Width="85" 
                    IsDefault="True" 
                    Click="BtnOk_Click" 
                    Margin="0,0,10,0" />
            <Button Content="{DynamicResource PulsanteAnnulla}"
                    Width="85" 
                    IsCancel="True" 
                    Click="BtnCancel_Click" />
        </StackPanel>
    </Grid>
</Window>
