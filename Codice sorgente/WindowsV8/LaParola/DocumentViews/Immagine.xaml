<UserControl x:Class="LaParola.DocumentViews.Immagine"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LaParola.DocumentViews"
             xmlns:controls="clr-namespace:LaParola"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid Background="#7F000000">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      HorizontalScrollBarVisibility="Auto" 
                      VerticalScrollBarVisibility="Auto">

            <ScrollViewer.Resources>
                <Style TargetType="ContextMenu">
                    <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                </Style>
                <Style TargetType="MenuItem">
                    <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/>
                    <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Padding" Value="6,4"/>

                    <Style.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#3D26A0DA"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.MenuHighlightBrushKey}" Color="#3D26A0DA"/>
                    </Style.Resources>
                </Style>
            </ScrollViewer.Resources>
            
            <ScrollViewer.ContextMenu>
                <ContextMenu x:Name="pmZoom" Opened="PmZoom_Opening">
                    <MenuItem Header="25%" Click="PmZoomVoce_Click" Tag="25" />
                    <MenuItem Header="50%" Click="PmZoomVoce_Click" Tag="50" />
                    <MenuItem Header="100%" Click="PmZoomVoce_Click" Tag="100" />
                    <MenuItem Header="150%" Click="PmZoomVoce_Click" Tag="150" />
                    <MenuItem Header="200%" Click="PmZoomVoce_Click" Tag="200" />
                </ContextMenu>
            </ScrollViewer.ContextMenu>

            <Grid x:Name="DisplayGrid" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.LayoutTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1" />
                    </TransformGroup>
                </Grid.LayoutTransform>

                <Image x:Name="pbImmagine" Stretch="None" />

                <Canvas x:Name="LinkCanvas" 
                        Background="Transparent"
                        MouseMove="PbImmagine_MouseMove" 
                        MouseUp="PbImmagine_MouseUp"
                        MouseLeave="LinkCanvas_MouseLeave"/>
            </Grid>
        </ScrollViewer>

        <StatusBar Grid.Row="1">
            <StatusBarItem HorizontalAlignment="Left">
                <TextBlock x:Name="txtStatus" FontSize="12" Margin="5,0" />
            </StatusBarItem>

            <StatusBarItem HorizontalAlignment="Right" Margin="0,0,5,0">
                <controls:HelpFlyout x:Name="HelpFlyoutControl"
                             HelpText="{DynamicResource ImmagineAiuto}"
                             HelpClicked="HelpFlyout_OnHelpClicked"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
    
</UserControl>
