<UserControl x:Class="LaParola.DocumentViews.ViewerDocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks" xmlns:controls="clr-namespace:LaParola"
             Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource AppForegroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="LeftPanel" Grid.Column="0" Visibility="Collapsed"
                Background="{DynamicResource ControlBackgroundBrush}"
                BorderBrush="{DynamicResource SubtleBorderBrush}"
                BorderThickness="0,0,1,0" Margin="0,4,0,4">
            <TreeView x:Name="TocTreeView" Background="Transparent" BorderThickness="0" Margin="4" Padding="0,0,8,0"
                      SelectedItemChanged="TocTreeView_SelectedItemChanged"/>
        </Border>

        <GridSplitter x:Name="Splitter" Grid.Column="1" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="Transparent" ShowsPreview="True"
                      Visibility="{Binding ElementName=LeftPanel, Path=Visibility}"/>

        <DockPanel Grid.Column="2">
            <Grid Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Background="{DynamicResource ControlBackgroundBrush}"
                            BorderBrush="{DynamicResource SubtleBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="4">
                        <WrapPanel VerticalAlignment="Center" ItemHeight="32">

                            <Button x:Name="BtnToggleToc" Style="{StaticResource ToolbarIconButton}" Click="BtnToggleToc_Click" ToolTip="{DynamicResource ViewerSommarioAiuto}" Width="34" Height="30">
                                <iconPacks:PackIconMaterial Kind="ViewList"/>
                            </Button>
                            <Border Width="1" Height="18" Background="{DynamicResource SubtleBorderBrush}" Margin="6,0"/>

                            <TextBox x:Name="TxtReference" 
                                     Width="90" Height="24" Margin="4,0" 
                                     VerticalContentAlignment="Center"
                                     Background="{DynamicResource AppBackgroundBrush}" 
                                     Foreground="{DynamicResource AppForegroundBrush}"
                                     BorderBrush="{DynamicResource SubtleBorderBrush}" 
                                     KeyDown="TxtReference_KeyDown"
                                     ToolTip="{DynamicResource ViewerRiferimentoAiuto}"/>

                            <Button x:Name="BtnGoReference" 
                                    Style="{StaticResource ToolbarIconButton}" 
                                    Click="BtnGoReference_Click" 
                                    ToolTip="{DynamicResource ViewerVaiRiferimentoAiuto}"
                                    Width="28" Height="28">
                                <iconPacks:PackIconMaterial Kind="ArrowRightThick" Width="12" Height="12"/>
                            </Button>

                            <Border Width="1" Height="18" Background="{DynamicResource SubtleBorderBrush}" Margin="6,0"/>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource ViewerLibroAbb}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" 
                                           Foreground="{DynamicResource AppForegroundBrush}"/>
                                <Button x:Name="BtnPrevBook" Style="{StaticResource ToolbarIconButton}" Click="BtnPrevBook_Click" ToolTip="{DynamicResource ViewerLibroPrecedente}" Width="24" Height="28">
                                    <iconPacks:PackIconMaterial Kind="ChevronUp" Width="12" Height="12"/>
                                </Button>
                                <Button x:Name="BtnNextBook" Style="{StaticResource ToolbarIconButton}" Click="BtnNextBook_Click" ToolTip="{DynamicResource ViewerLibroSuccessivo}" Width="24" Height="28" Margin="-12,0,0,0">
                                    <iconPacks:PackIconMaterial Kind="ChevronDown" Width="12" Height="12"/>
                                </Button>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                <TextBlock Text="{DynamicResource ViewerCapitoloAbb}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" 
                                           Foreground="{DynamicResource AppForegroundBrush}"/>
                                <Button x:Name="BtnPrevChapter" Style="{StaticResource ToolbarIconButton}" Click="BtnPrevChapter_Click" ToolTip="{DynamicResource ViewerCapitoloPrecedente}" Width="18" Height="28">
                                    <iconPacks:PackIconMaterial Kind="ChevronUp" Width="12" Height="12"/>
                                </Button>
                                <Button x:Name="BtnNextChapter" Style="{StaticResource ToolbarIconButton}" Click="BtnNextChapter_Click" ToolTip="{DynamicResource ViewerCapitoloSuccessivo}" Width="18" Height="28" Margin="-12,0,0,0">
                                    <iconPacks:PackIconMaterial Kind="ChevronDown" Width="12" Height="12"/>
                                </Button>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                <TextBlock Text="{DynamicResource ViewerVersettoAbb}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" 
                                           Foreground="{DynamicResource AppForegroundBrush}"/>
                                <Button x:Name="BtnPrevVerse" Style="{StaticResource ToolbarIconButton}" Click="BtnPrevVerse_Click" ToolTip="{DynamicResource ViewerVersettoPrecedente}" Width="12" Height="28">
                                    <iconPacks:PackIconMaterial Kind="ChevronUp" Width="12" Height="12"/>
                                </Button>
                                <Button x:Name="BtnNextVerse" Style="{StaticResource ToolbarIconButton}" Click="BtnNextVerse_Click" ToolTip="{DynamicResource ViewerVersettoSuccessivo}" Width="12" Height="28" Margin="-12,0,0,0">
                                    <iconPacks:PackIconMaterial Kind="ChevronDown" Width="12" Height="12"/>
                                </Button>
                            </StackPanel>

                            <Border Width="1" Height="18" Background="{DynamicResource SubtleBorderBrush}" Margin="8,0"/>

                            <TextBox x:Name="TxtSearchWord" 
                                     Width="120" Height="24" Margin="4,0" 
                                     VerticalContentAlignment="Center"
                                     Background="{DynamicResource AppBackgroundBrush}" 
                                     Foreground="{DynamicResource AppForegroundBrush}"
                                     BorderBrush="{DynamicResource SubtleBorderBrush}" 
                                     KeyDown="TxtSearchWord_KeyDown"
                                     ToolTip="{DynamicResource ViewerRicercaAiuto}"/>

                            <Button x:Name="BtnExecuteSearch" 
                                    Style="{StaticResource ToolbarIconButton}" 
                                    Click="BtnExecuteSearch_Click" 
                                    ToolTip="{DynamicResource ViewerVaiRicercaAiuto}"
                            Width="28" Height="28">
                                <iconPacks:PackIconMaterial Kind="Magnify" Width="12" Height="12"/>
                            </Button>

                            <ComboBox x:Name="CmbSearchResults" 
                                      Width="160" Height="24" Margin="6,0,4,0" 
                                      VerticalContentAlignment="Center"
                                      IsEnabled="False" 
                                      SelectionChanged="CmbSearchResults_SelectionChanged"
                                      ToolTip="{DynamicResource ViewerRicercaVersettiAiuto}"/>

                            <Border Width="1" Height="18" Background="{DynamicResource SubtleBorderBrush}" Margin="6,0"/>

                            <Button x:Name="BtnIndietro" Style="{StaticResource ToolbarIconButton}" Click="Indietro_Click" ToolTip="{DynamicResource ViewerIndietroAiuto}" IsEnabled="False" Width="34" Height="30">
                                <iconPacks:PackIconMaterial Kind="ArrowLeft"/>
                            </Button>
                            <Button x:Name="BtnAvanti" Style="{StaticResource ToolbarIconButton}" Click="Avanti_Click" ToolTip="{DynamicResource ViewerAvantiAiuto}" IsEnabled="False" Width="34" Height="30">
                                <iconPacks:PackIconMaterial Kind="ArrowRight"/>
                            </Button>

                            <Border Width="1" Height="18" Background="{DynamicResource SubtleBorderBrush}" Margin="6,0"/>

                            <Button x:Name="BtnSync" Style="{StaticResource ToolbarIconButton}" 
        Click="BtnSync_Click" ToolTip="{DynamicResource ViewerSincAiuto0}" Width="38" Height="30">

                                <Button.Resources>
                                    <Style TargetType="ContextMenu">
                                        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                    </Style>

                                    <Style TargetType="MenuItem">
                                        <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/>
                                        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Margin" Value="0"/>
                                        <Setter Property="Padding" Value="6,4"/>

                                        <Style.Resources>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#3D26A0DA"/>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.MenuHighlightBrushKey}" Color="#3D26A0DA"/>
                                        </Style.Resources>
                                    </Style>

                                    <Style TargetType="Separator">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Separator">
                                                    <Border Background="{DynamicResource ControlBackgroundBrush}" Padding="32,4,0,4">
                                                        <Border BorderThickness="0,1,0,0" 
                                BorderBrush="{DynamicResource SubtleBorderBrush}" 
                                Height="1" 
                                VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Resources>

                                <Grid>
                                    <iconPacks:PackIconMaterial x:Name="IconSyncBrano" Kind="LinkOff" Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <Border x:Name="BadgeSync" 
                Background="{DynamicResource AppForegroundBrush}" 
                CornerRadius="2" Padding="2,0" Height="11" MinWidth="11"
                VerticalAlignment="Bottom" HorizontalAlignment="Right" 
                Margin="0,0,-4,-2" Visibility="Collapsed">
                                        <TextBlock x:Name="TxtSyncGroup" Text="1" FontSize="8" FontWeight="Bold" 
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource AppBackgroundBrush}"/>
                                    </Border>
                                </Grid>

                                <Button.ContextMenu>
                                    <ContextMenu x:Name="MenuSync">
                                        <MenuItem Header="{DynamicResource ViewerSincNo}" Tag="0" Click="MenuSyncItem_Click">
                                            <MenuItem.Icon>
                                                <iconPacks:PackIconMaterial Kind="LinkOff" Width="12" Height="12"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator/>
                                        <MenuItem Header="{DynamicResource ViewerSinc1}" Tag="1" Click="MenuSyncItem_Click"/>
                                        <MenuItem Header="{DynamicResource ViewerSinc2}" Tag="2" Click="MenuSyncItem_Click"/>
                                        <MenuItem Header="{DynamicResource ViewerSinc3}" Tag="3" Click="MenuSyncItem_Click"/>
                                        <MenuItem Header="{DynamicResource ViewerSinc4}" Tag="4" Click="MenuSyncItem_Click"/>
                                        <MenuItem Header="{DynamicResource ViewerSinc5}" Tag="5" Click="MenuSyncItem_Click"/>
                                        <MenuItem Header="{DynamicResource ViewerSinc6}" Tag="6" Click="MenuSyncItem_Click"/>
                                        <MenuItem Header="{DynamicResource ViewerSinc7}" Tag="7" Click="MenuSyncItem_Click"/>
                                        <MenuItem Header="{DynamicResource ViewerSinc8}" Tag="8" Click="MenuSyncItem_Click"/>
                                        <MenuItem Header="{DynamicResource ViewerSinc9}" Tag="9" Click="MenuSyncItem_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>

                        </WrapPanel>
                    </Border>
                    <controls:HelpFlyout x:Name="HelpFlyoutControl" Grid.Column="1" Margin="0,8,0,0" HelpText="{DynamicResource ViewerAiuto}" HelpClicked="HelpFlyout_OnHelpClicked"/>
                </Grid>
                <Grid Grid.Row="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <controls:RichTextBoxEx x:Name="Viewer" Margin="0,6,0,0" IsReadOnly="True" IsUndoEnabled="False" IsDocumentEnabled="True" VerticalScrollBarVisibility="Hidden" PreviewKeyDown="RtfTesto_PreviewKeyDown" KeyUp="RtfTesto_KeyUp" PreviewMouseWheel="Viewer_PreviewMouseWheel">
                            <controls:RichTextBoxEx.Resources>
                                <Style TargetType="{x:Type Paragraph}">
                                    <Setter Property="Margin" Value="0"/>
                                </Style>
                            </controls:RichTextBoxEx.Resources>
                        </controls:RichTextBoxEx>
                        <ScrollBar x:Name="SBViewer" Grid.Column="1" Margin="0,6,0,0" Minimum="1" Value="1" SmallChange="0.00001" LargeChange="0.0001" Orientation="Vertical" Scroll="SBViewer_Scroll"/>
                    </Grid>
                </Grid>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>